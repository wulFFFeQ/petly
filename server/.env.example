# Server-only — NEVER prefix with VITE_ / never commit real secrets.

# Required for API to accept requests beyond /health
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loved_and_known
SESSION_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:5173
PORT=3001
COOKIE_SECURE=false
SESSION_TTL_DAYS=14

# Optional S3-compatible object storage (signed URLs). Without these, download returns not_configured.
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=pet-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# Document upload stays disabled until a real malware scanner is configured.
# MALWARE_SCAN_PROVIDER=
