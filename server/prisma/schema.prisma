  @@index([createdAt])
  @@index([correlationId])
  @@map("audit_events")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  storageKey     String   @unique @map("storage_key")
  actorAccountId String   @map("actor_account_id") @db.Uuid
  operation      String
  resourceRef    String   @map("resource_ref")
  clientKey      String   @map("client_key")
  fingerprint    String
  state          String
  result         Json?
  errorCode      String?  @map("error_code")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  actor Account @relation(fields: [actorAccountId], references: [id], onDelete: Cascade)

  @@unique([actorAccountId, operation, resourceRef, clientKey])
  @@index([actorAccountId])
  @@index([createdAt])
  @@map("idempotency_records")
}
