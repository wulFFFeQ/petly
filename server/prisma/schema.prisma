model AuditEvent {
  id              String   @id @default(uuid()) @db.Uuid
  kind            String   @default("authorization_decision")
  actorAccountId  String?  @map("actor_account_id") @db.Uuid
  actorType       String?  @map("actor_type")
  resourceType    String   @map("resource_type")
  resourceId      String   @map("resource_id")
  action          String
  result          String
  reasonCode      String?  @map("reason_code")
  denyCode        String?  @map("deny_code")
  denyClass       String?  @map("deny_class")
  organizationId  String?  @map("organization_id") @db.Uuid
  professionalId  String?  @map("professional_id") @db.Uuid
  membershipId    String?  @map("membership_id") @db.Uuid
  grantId         String?  @map("grant_id") @db.Uuid
  permission      String?
  allowPath       String?  @map("allow_path")
  correlationId   String?  @map("correlation_id")
  requestId       String?  @map("request_id")
  idempotencyRef  String?  @map("idempotency_ref")
