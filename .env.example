# LOVED & KNOWN — environment variable names (no secrets).
# Copy to `.env.local` for local Vite overrides. Never commit real keys.

# --- Client (Vite) — non-secret flags / public keys only ---
# Payment provider selection is forced DEMO in code until live Stripe is wired.
VITE_PAYMENT_PROVIDER=demo
# Dev-only microchip mock (ignored unless import.meta.env.DEV).
VITE_MICROCHIP_MOCK=false

# Supabase public client config (LAUNCH 02/03). Safe to expose in browser.
# When unset → DEMO mode + PRODUCTION CONNECTION NOT CONFIGURED.
# See docs/LAUNCH-03-SUPABASE-SETUP.md for project + Edge setup.
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# --- Build / hosting ---
# Set to true in GitHub Pages workflow to use base path /petly/
# GITHUB_PAGES=true

# --- Server-only (Edge Functions) — NEVER prefix with VITE_ ---
# These belong exclusively on Edge Functions / backend runtime.
# Never put service_role in React, localStorage, public env, source, URL, or logs.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_SECRET
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# ALLOWED_ORIGINS=http://localhost:5173

# Deferred / post-LAUNCH-03 (do not enable live charging yet):
# API_BASE_URL=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CONNECT_CLIENT_ID=
# STRIPE_PLATFORM_ACCOUNT_ID=
# SENTRY_DSN=
# MONITORING_API_KEY=
# OBJECT_STORAGE_BUCKET=pet-documents
# MALWARE_SCAN_PROVIDER=  # required before production document upload
