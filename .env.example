# LOVED & KNOWN — environment variable names (no secrets).
# Copy to `.env.local` for local Vite overrides. Never commit real keys.

# --- Client (Vite) — non-secret flags / public keys only ---
VITE_PAYMENT_PROVIDER=demo
VITE_MICROCHIP_MOCK=false

# Node API base URL (cookie sessions). When unset → DEMO mode.
# VITE_API_BASE_URL=http://localhost:3001

# --- Build / hosting ---
# GITHUB_PAGES=true

# --- Server-only (server/.env) — NEVER prefix with VITE_ ---
# See server/.env.example
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loved_and_known
# SESSION_SECRET=change-me-to-a-long-random-string
# ALLOWED_ORIGINS=http://localhost:5173
# S3_BUCKET=pet-documents
# MALWARE_SCAN_PROVIDER=

# Deferred:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
